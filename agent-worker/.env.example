# Copy to agent-worker/.env and fill in. Never commit real values.
# `pnpm --filter agent-worker dev` reads .env; on Render, set these in the
# service's Environment tab instead.

# Which chat the worker connects to:
#   terminal  a chat window in this terminal, for development. Needs no
#             Photon credentials.
#   imessage  real texts through Photon. Needs PHOTON_PROJECT_ID and PHOTON_PROJECT_SECRET.
AGENT_PROVIDER=terminal

# Photon dashboard > your project > Settings. Only for AGENT_PROVIDER=imessage.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# The app the worker posts each text to. No path, no trailing slash needed.
REEFLECT_URL=http://localhost:3000

# The same value as AGENT_SERVICE_TOKEN in the app's own env (ADR-032).
AGENT_SERVICE_TOKEN=

# Port for GET /health. Render sets PORT itself; leave empty locally.
PORT=
