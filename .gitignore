# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dynamic planning file, decisions and rules are stored in docs/agents, not here
plan.md
# outbox for emails when RESEND_API_KEY is unset (ADR-052)
/.email-outbox/

# real or redacted sample statements: never committed (TEST-08)
tests/fixtures/**/private/
