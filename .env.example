# Every environment variable the app and worker use (ARCH-09), with fake
# values. Copy to .env.local and fill in real values. Never commit .env.local.

# Database (ADR-005). Neon: use the pooled connection string.
DATABASE_URL=postgres://user:password@localhost:5432/reeflect

# Better Auth (ADR-006). Secret: 32+ random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Not read by the app yet; each arrives with its feature.
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PLAID_ENV=sandbox
PLAID_CLIENT_ID=fake
PLAID_SECRET=fake
GEMINI_API_KEY=fake
GEMINI_MODEL=fake
NESSIE_API_KEY=fake
NESSIE_BASE_URL=http://api.nessieisreal.com
AGENT_SERVICE_TOKEN=replace-with-32-or-more-random-bytes
AGENT_WORKER_URL=http://localhost:8787
REEFLECT_URL=http://localhost:3000
PHOTON_PROJECT_ID=fake
PHOTON_PROJECT_SECRET=fake
CRON_SECRET=fake
DEMO_MODE=false
