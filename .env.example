# Copy to .env.local and fill in. Never commit real values.
# The app's variables are validated at startup by src/lib/env.ts (ARCH-09).
# NESSIE_API_KEY joins them with the Nessie client; the script-only ones at
# the bottom never do.

# Neon: Dashboard > Connect. Copy BOTH strings for the same branch.
# Runtime: the POOLED string (host contains "-pooler"), with sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Migrations only: the DIRECT string (same host without "-pooler").
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# Better Auth (ADR-006). Secret: 32+ random characters, e.g.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional: Better Auth Infrastructure dashboard (ADR-047). From your project
# at https://better-auth.com/dashboard. Leave empty to turn the dashboard off.
BETTER_AUTH_API_KEY=

# Capital One Nessie sandbox key (from your Nessie profile). Server-side only
# (ADR-033): never give it a NEXT_PUBLIC_ name, or it ships to the browser.
NESSIE_API_KEY=replace-me

# iMessage agent (ADR-032, ADR-050). The worker sends this token to
# /api/agent/turn; 32+ random characters, e.g. openssl rand -base64 32.
# Leave empty and the endpoint answers 404 to everyone.
AGENT_SERVICE_TOKEN=
# Optional: the number users text, shown on the Settings card, as +15551234567.
# Leave empty on Photon's shared pool, where there is no single number.
AGENT_PHONE_NUMBER=

# Scripts only (ADR-049, docs/SYNTHETIC.md); the app never reads these.
# The Neon batch-testing branch: its pooled string is fine, scripts connect
# directly. Optionally set DATABASE_URL_BATCHTESTINGBRANCH_UNPOOLED as well.
DATABASE_URL_BATCHTESTINGBRANCH=
# Production's endpoint id, the "ep-..." part of its host without "-pooler".
# Not a secret. Scripts refuse to write to production unless it matches.
NEON_PRODUCTION_ENDPOINT_ID=

# To use the local database from `docker compose up -d` instead:
# DATABASE_URL=postgres://test:test@localhost:5433/app_test

GEMINI_API_KEY=replace-me
