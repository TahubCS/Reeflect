# Copy to .env.local and fill in. Never commit real values.
# The app's variables are validated at startup by src/lib/env.ts (ARCH-09).
# The script-only ones at the bottom never are.

# Neon: Dashboard > Connect. Copy BOTH strings for the same branch.
# Runtime: the POOLED string (host contains "-pooler"), with sslmode=require.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Migrations only: the DIRECT string (same host without "-pooler").
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# Better Auth (ADR-006). Secret: 32+ random characters, e.g.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional: Better Auth Infrastructure dashboard (ADR-047). From your project
# at https://better-auth.com/dashboard. Leave empty to turn the dashboard off.
BETTER_AUTH_API_KEY=

# Resend (ADR-052): verification and password-reset emails. Required on
# Vercel. Leave empty locally to write emails to .email-outbox/ instead.
# Key: Resend > API Keys, "Sending access" for the verified domain only.
RESEND_API_KEY=
# A sender on the Resend-verified domain.
EMAIL_FROM="Reeflect <no-reply@example.com>"

# Neon object storage for statement CSVs (ADR-053). All five or none; without
# them statement import is switched off. Neon names the first four; copy them
# from `neon env pull --branch storage-tests --file .env.storage-tests` for
# local development. Never use production's here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
STATEMENTS_BUCKET=statements

# Capital One Nessie sandbox key (from your Nessie profile). Server-side only
# (ADR-033): never give it a NEXT_PUBLIC_ name, or it ships to the browser.
NESSIE_API_KEY=replace-me

# iMessage agent (ADR-032, ADR-051). The worker sends this token to
# /api/agent/turn; 32+ random characters, e.g. openssl rand -base64 32.
# Leave empty and the endpoint answers 404 to everyone.
AGENT_SERVICE_TOKEN=
# Optional: the agent worker's address (on Render, its public URL; locally
# http://localhost:8787). The app posts there to tell a phone it has been
# linked (ADR-062). Leave empty and no such text is sent.
AGENT_WORKER_URL=
# Optional: the number users text, shown on the Settings card, as +15551234567.
# Leave empty on Photon's shared pool, where there is no single number.
AGENT_PHONE_NUMBER=

# Scripts only (ADR-049, docs/SYNTHETIC.md); the app never reads these.
# The Neon batch-testing branch: its pooled string is fine, scripts connect
# directly. Optionally set DATABASE_URL_BATCHTESTINGBRANCH_UNPOOLED as well.
DATABASE_URL_BATCHTESTINGBRANCH=
# Production's endpoint id, the "ep-..." part of its host without "-pooler".
# Not a secret. Scripts refuse to write to production unless it matches.
NEON_PRODUCTION_ENDPOINT_ID=

# To use the local database from `docker compose up -d` instead:
# DATABASE_URL=postgres://test:test@localhost:5433/app_test

# Gemini key for the agent's replies (ADR-019, ADR-059). Leave empty and the
# agent answers with replies built by code. `pnpm ai:check` tests the key.
GEMINI_API_KEY=
# Optional: models to try, in order, comma-separated (six at most). Leave
# empty: a deployment then uses the models for users and your machine a
# separate test model, so local work never uses up the users' daily
# allowance (src/lib/ai/models.ts).
GEMINI_MODELS=
# Optional: `on` lets the agent send a receipt photo to Gemini (F-29,
# ADR-067). Leave empty (off) while the key is on the free tier: only
# made-up receipts may be sent there. Off, a photo gets a reply that asks
# for the amount by text, and no model is called.
AGENT_RECEIPT_PHOTOS=
